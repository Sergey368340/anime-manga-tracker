<section class="panel">
  <h2>Редактировать запись</h2>

  <form class="form-stack" method="post" action="/lists/anime/{{entry.animeId}}/update{{authQuery}}">

    <div class="form-row">
      <label class="form-label">Статус</label>
      <select class="form-select" name="status">
        <option value="WATCHING" {{#if (eq entry.status "WATCHING")}}selected{{/if}}>Смотрю</option>
        <option value="COMPLETED" {{#if (eq entry.status "COMPLETED")}}selected{{/if}}>Просмотрено</option>
        <option value="PLAN_TO_WATCH" {{#if (eq entry.status "PLAN_TO_WATCH")}}selected{{/if}}>Планирую</option>
      </select>
    </div>

    <div class="form-row">
      <label class="form-label">Эпизоды</label>
      <input
        class="form-input"
        name="progressEpisodes"
        type="number"
        min="0"
        max="{{entry.anime.episodes}}"
        value="{{entry.progressEpisodes}}"
      />
    </div>

    <div class="form-row">
      <label class="form-label">Оценка</label>
      <input
        class="form-input"
        name="score"
        type="number"
        min="0"
        max="10"
        value="{{entry.score}}"
      />
    </div>

    <div class="form-row">
      <label class="form-label">Заметки</label>
      <textarea
        class="form-textarea"
        name="notes"
        rows="4"
      >{{entry.notes}}</textarea>
    </div>

    <div class="form-actions">
      <button class="btn btn-primary" type="submit">
        Сохранить
      </button>
    </div>

  </form>

  <form method="post" action="/lists/anime/{{entry.animeId}}/delete{{authQuery}}">
    <button class="btn btn-danger" type="submit">
      Удалить из списка
    </button>
  </form>

</section>