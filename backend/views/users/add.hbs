<section class="panel">
  <h2>Регистрация</h2>

  <form class="form-stack" method="post" action="/users">

    <div class="form-row">
      <label class="form-label">Имя</label>
      <input class="form-input" name="username" placeholder="Имя" required />
    </div>

    <div class="form-row">
      <label class="form-label">Email</label>
      <input class="form-input" name="email" placeholder="Email" required />
    </div>

    <div class="form-actions">
      <button class="btn btn-primary" type="submit">
        Создать
      </button>
    </div>

  </form>
</section>